# Local preview: leave DATABASE_URL empty. Local SQLite is not cloud storage.
ENVIRONMENT=local
DATABASE_URL=
DATABASE_SSLMODE=require
LOCAL_DB_PATH=feedback.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1

# On Render set ENVIRONMENT=cloud and DATABASE_URL to the Supabase session-pooler
# connection string. Never put a real database password in a committed file.
FEEDBACK_LIMIT=500
WRITE_LIMIT=10
